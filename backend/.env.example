# ==============================
# SERVER CONFIGURATION
# ==============================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ==============================
# MONGODB CONFIGURATION
# ==============================
MONGO_URI=mongodb://127.0.0.1:27017/career_matrix

# ==============================
# JWT CONFIGURATION
# ==============================
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ==============================
# RESET PASSWORD TOKEN
# ==============================
RESET_PASSWORD_EXPIRE=10

# ==============================
# EMAIL CONFIGURATION (SMTP)
# ==============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=Career Matrix <no-reply@careermatrix.com>

# ==============================
# FILE UPLOAD CONFIGURATION
# ==============================
MAX_PROFILE_IMAGE_SIZE=2000000
MAX_RESUME_SIZE=5000000
MAX_CERTIFICATE_SIZE=5000000
PROFILE_IMAGE_UPLOAD_PATH=./uploads/profiles
RESUME_UPLOAD_PATH=./uploads/resumes
CERTIFICATE_UPLOAD_PATH=./uploads/certificates
